     "sha256": "4159db74a614655f4a33a1ddcf90c24e335571bcf72ed9908229ec5df3f00d90",
     "orig_last_modified": null,
     "orig_date": "Sat, 21 Mar 2026 21:39:33 GMT",
     "orig_last_modified_local": null,
     "upload_on_election_night": false,
     "updated_strings": [],
     "text_sample": "{\"id\":10328,\"date\":\"2025-01-15T12:55:41\",\"date_gmt\":\"2025-01-15T18:55:41\",\"guid\":{\"rendered\":\"https:\\/\\/wichitacountytx.com\\/?post_type=election_info&#038;p=10328\"},\"modified\":\"2025-12-10T11:07:01\",\"modified_gmt\":\"2025-12-10T17:07:01\",\"slug\":\"pollworkers\",\"status\":\"publish\",\"type\":\"election_info\",\"link\":\"https:\\/\\/wichitacountytx.com\\/election_info\\/pollworkers\\/\",\"title\":{\"rendered\":\"Poll workers\"},\"content\":{\"rendered\":\"\\n How to become an Election Worker \\n\\n\\n\\n Poll workers make voting possible. Poll worker duties included checking in voters and assisting voters with voting equipment as needed and are PAID positions. Workers must be registered voters in Wichita County and able to attend any required trainings prior to their start date. Trainings are held one (if not twice) per year prior to the March and November Elections. Additional training could be scheduled if deemed necessary. Please complete the application below. You may mail it to our office or email the form to us at&nbsp;elections@co.wichita.tx.us. \\n\\n\\n\\n You can also visit the\\u00a0 Texas Election Training Portal \\u00a0for more information. The State of Texas offers a variety of free online course. NOTE: Wichita County does require all Election Workers to attend in person training as well. \\n\\n\\n\\n Poll Worker Application \\n\\n\\n\\n \\n\\n\\n\\n Student Poll Worker Program \\n\\n\\n\\n This program is designed to provide students with a greater awareness of the electoral process and the rights and responsibilities of voters. The students will assist their local election officials by filling positions at polling places during the Early Voting period or on Election Day and working under the direction of the polling place presiding judge. Student election clerks must be 16 years or older on Election Day, be enrolled in a public, private or qualified home school program and be a US Citizen. Student election clerks must also have the consent of their legal guardian and school principal in order to work an election. and attend any required trainings. Students are paid hourly for their service. \\n\\n\\n\\n Student Clerk Application and Permission Form \\n\",\"protected\":false},\"featured_media\":0,\"template\":\"\",\"class_list\":[\"post-10328\",\"election_info\",\"type-election_info\",\"status-publish\",\"hentry\"],\"publishpress_future_workflow_manual_trigger\":{\"enabledWorkflows\":[]},\"_links\":{\"self\":[{\"href\":\"https:\\/\\/wichitacountytx.com\\/wp-json\\/wp\\/v2\\/election_info\\/10328\",\"targetHints\":{\"allow\":[\"GET\"]}}],\"collection\":[{\"href\":\"https:\\/\\/wichitacountytx.com\\/wp-json\\/wp\\/v2\\/election_info\"}],\"about\":[{\"href\":\"https:\\/\\/wichitacountytx.com\\/wp-json\\/wp\\/v2\\/types\\/election_info\"}],\"wp:attachment\":[{\"href\":\"https:\\/\\/wichitacountytx.com\\/wp-json\\/wp\\/v2\\/media?parent=10328\"}],\"curies\":[{\"name\":\"wp\",\"href\":\"https:\\/\\/api.w.org\\/{rel}\",\"templated\":true}]}}",
