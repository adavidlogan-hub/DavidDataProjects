     "text_sample": "{\"version\":\"1.0\",\"provider_name\":\"Wichita County\",\"provider_url\":\"https:\\/\\/wichitacountytx.com\",\"author_name\":\"Matthew Cameron\",\"author_url\":\"https:\\/\\/wichitacountytx.com\\/author\\/matthew-cameron\\/\",\"title\":\"Poll workers\",\"type\":\"rich\",\"width\":600,\"height\":338,\"html\":\" Poll workers \\n\\/* *\\/\\n \\n\"}",
