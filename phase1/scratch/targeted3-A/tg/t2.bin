  <h1 class="page-title">Here&#039;s How the March 3 Primary Went in Tom Green County</h1>


      </div>


  <div class="views-element-container block block--views block--views-block:authored-informations-block-1 block-views block-views-blockauthored-informations-block-1">
          
            
              <div><div class="view view-authored-informations view-id-authored_informations view-display-id-block_1 js-view-dom-id-c96d8aefdfa4b801c6a3aa970401c729b9e99659966af1405a34020ceb2e5d83">
  
    
      
      <div class="view-content">
          <div class="views-row"><div class="views-field views-field-nothing"><span class="field-content"><div class="post-meta d-flex align-items-center">
  <div class="author-picture mr-2">
  <a href="/members/lucasbanda" hreflang="en"><img loading="lazy" src="/sites/default/files/styles/thumbnail/public/default_images/default-user.png?itok=hNrlYQTo" width="100" height="100" alt="Default User Picture" class="img-fluid" />

</a>

</div> 
  <div>
By <span class="author-name">Lucas Banda</span>, <span class="created-date"><time datetime="2026-03-04T12:07:20-06:00" class="datetime">Mar 4, 2026</time>
</span>
</div>
</div></span></div></div>

    </div>
  
          </div>
